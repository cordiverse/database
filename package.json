{
  "name": "@root/database",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "docs",
    "external/*",
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "lint": "oxlint",
    "yakumo": "node --expose-internals --import tsx node_modules/yakumo/lib/cli.js",
    "postinstall": "yarn yakumo postinstall",
    "build": "yarn yakumo esbuild && yarn yakumo tsc",
    "test": "yarn yakumo vitest --import tsx -t 10000",
    "test:text": "shx rm -rf coverage && yarn test --coverage --coverage.reporter text",
    "test:json": "shx rm -rf coverage && yarn test --coverage --coverage.reporter json",
    "test:html": "shx rm -rf coverage && yarn test --coverage --coverage.reporter html"
  },
  "devDependencies": {
    "@cordisjs/oxlint-config": "^1.0.0",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "oxlint": "^1.93.0",
    "shx": "^0.4.0",
    "tsx": "npm:@cordisjs/tsx@4.23.15-fix.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5",
    "yakumo": "^4.0.0",
    "yakumo-esbuild": "^4.0.0",
    "yakumo-tsc": "^4.0.0",
    "yakumo-vitest": "^2.0.0"
  }
}
